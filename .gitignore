# Sky Wardens Comprehensive Gitignore

# Dependencies across all apps and submodules
node_modules/
*/node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment variables & secrets across all apps
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
*/.env
*/.env.*
*/.env.local
**/.env
**/.env.*
**/.env.local
**/.env.*.local
*.local
!*.env.example

# Next.js & React Build outputs
.next/
*/.next/
**/.next/
dist/
*/dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
out/
**/out/

# Logs & Debugging
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Uploads & temporary media
uploads/
**/uploads/

# IDE & OS files
.DS_Store
Thumbs.db
.idea/
**/.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.tsbuildinfo
