# Root Gitignore for Sky Wardens Project

# Dependencies across all apps
node_modules/
*/node_modules/

# Environment files across all apps
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*/.env
*/.env.*
*/.env.local
!*.env.example

# Build outputs
dist/
*/dist/
.next/
*/.next/

# Logs & temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
.idea/
.vscode/
